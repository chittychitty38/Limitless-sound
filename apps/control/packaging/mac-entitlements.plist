<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only when the app is signed with the Developer ID (.github/scripts/mac-sign.sh, SIGNING.md).
     The hardened runtime that notarization needs turns off what these turn back on. -->
<plist version="1.0">
<dict>
    <!-- Python builds small pieces of code at run time (ctypes and PyObjC callbacks) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Python loads its extension modules, and pygame loads SDL -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
