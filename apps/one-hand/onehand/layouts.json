{
  "_comment": "What each key does in one-hand mode. Keys are written for the LEFT hand; the right hand is the mirror image. Modifiers use Mac names (command, option, control, shift); on Windows they become Ctrl, Alt, Win and Shift. To customise, copy this file into the app's settings folder and edit it there.",
  "apps": [
    {
      "id": "logic",
      "name": "Logic Pro",
      "mac": ["com.apple.logic10"],
      "windows": [],
      "commands": [
        {"key": "1", "label": "Go to start",        "send": "return_or_enter"},
        {"key": "2", "label": "Back one bar",       "send": "comma", "repeat": true},
        {"key": "3", "label": "Forward one bar",    "send": "period", "repeat": true},
        {"key": "4", "label": "Cycle on/off",       "send": "c"},
        {"key": "5", "label": "Metronome on/off",   "send": "k"},
        {"key": "q", "label": "Undo",               "send": "z", "mods": ["command"]},
        {"key": "w", "label": "Redo",               "send": "z", "mods": ["command", "shift"]},
        {"key": "e", "label": "Record",             "send": "r"},
        {"key": "r", "label": "Split at playhead",  "send": "t", "mods": ["command"]},
        {"key": "t", "label": "New track",          "send": "n", "mods": ["option", "command"]},
        {"key": "a", "label": "Mute track",         "send": "m"},
        {"key": "s", "label": "Solo track",         "send": "s"},
        {"key": "d", "label": "Duplicate track",    "send": "d", "mods": ["command"]},
        {"key": "f", "label": "Zoom to fit",        "send": "z"},
        {"key": "g", "label": "Save",               "send": "s", "mods": ["command"]},
        {"key": "z", "label": "Zoom out",           "send": "left_arrow", "mods": ["command"], "repeat": true},
        {"key": "x", "label": "Zoom in",            "send": "right_arrow", "mods": ["command"], "repeat": true},
        {"key": "c", "label": "Mixer",              "send": "x"},
        {"key": "v", "label": "Editor",             "send": "e"},
        {"key": "b", "label": "Library",            "send": "y"}
      ]
    },
    {
      "id": "protools",
      "name": "Pro Tools",
      "mac": ["com.avid.ProTools"],
      "windows": ["protools.exe"],
      "commands": [
        {"key": "1", "label": "Go to start",        "send": "return_or_enter"},
        {"key": "2", "label": "Go to end",          "send": "return_or_enter", "mods": ["option"]},
        {"key": "3", "label": "Loop playback",      "send": "l", "mods": ["command", "shift"]},
        {"key": "4", "label": "Edit/Mix window",    "send": "equal_sign", "mods": ["command"]},
        {"key": "5", "label": "New tracks",         "send": "n", "mods": ["command", "shift"]},
        {"key": "q", "label": "Undo",               "send": "z", "mods": ["command"]},
        {"key": "w", "label": "Redo",               "send": "z", "mods": ["command", "shift"]},
        {"key": "e", "label": "Record",             "send": "f12"},
        {"key": "r", "label": "Separate clip",      "send": "e", "mods": ["command"]},
        {"key": "t", "label": "Duplicate",          "send": "d", "mods": ["command"]},
        {"key": "a", "label": "Mute track",         "send": "m", "mods": ["shift"]},
        {"key": "s", "label": "Solo track",         "send": "s", "mods": ["shift"]},
        {"key": "d", "label": "Copy",               "send": "c", "mods": ["command"]},
        {"key": "f", "label": "Paste",              "send": "v", "mods": ["command"]},
        {"key": "g", "label": "Save",               "send": "s", "mods": ["command"]},
        {"key": "z", "label": "Zoom out",           "send": "open_bracket", "mods": ["command"], "repeat": true},
        {"key": "x", "label": "Zoom in",            "send": "close_bracket", "mods": ["command"], "repeat": true},
        {"key": "c", "label": "Cut",                "send": "x", "mods": ["command"]},
        {"key": "v", "label": "Heal separation",    "send": "h", "mods": ["command"]},
        {"key": "b", "label": "Delete",             "send": "delete_or_backspace"}
      ]
    },
    {
      "id": "garageband",
      "name": "GarageBand",
      "mac": ["com.apple.garageband10"],
      "windows": [],
      "commands": [
        {"key": "q", "label": "Undo",               "send": "z", "mods": ["command"]},
        {"key": "w", "label": "Redo",               "send": "z", "mods": ["command", "shift"]},
        {"key": "e", "label": "Record",             "send": "r"},
        {"key": "t", "label": "New track",          "send": "n", "mods": ["option", "command"], "note": "Opens the New Track dialog"},
        {"key": "g", "label": "Save",               "send": "s", "mods": ["command"]},
        {"key": "c", "label": "Automation",         "send": "a"},
        {"key": "b", "label": "Musical Typing",     "send": "k", "mods": ["command"]}
      ]
    },
    {
      "id": "reaper",
      "name": "REAPER",
      "mac": ["com.cockos.reaper"],
      "windows": ["reaper.exe"],
      "commands": [
        {"key": "1", "label": "Go to start",        "send": "w"},
        {"key": "2", "label": "Go to end",          "send": "end"},
        {"key": "3", "label": "Add marker",         "send": "m"},
        {"key": "4", "label": "Loop playback",      "send": "r"},
        {"key": "q", "label": "Undo",               "send": "z", "mods": ["command"]},
        {"key": "w", "label": "Redo",               "send": "z", "mods": ["command", "shift"]},
        {"key": "e", "label": "Record",             "send": "r", "mods": ["command"]},
        {"key": "r", "label": "Split at edit cursor", "send": "s"},
        {"key": "t", "label": "New track",          "send": "t", "mods": ["command"]},
        {"key": "a", "label": "Previous track",     "send": "up_arrow", "mods": ["command", "option"], "repeat": true},
        {"key": "s", "label": "Next track",         "send": "down_arrow", "mods": ["command", "option"], "repeat": true},
        {"key": "f", "label": "Zoom to fit",        "send": "page_down", "mods": ["command"]},
        {"key": "g", "label": "Save",               "send": "s", "mods": ["command"]},
        {"key": "c", "label": "Mixer",              "send": "m", "mods": ["command"]}
      ]
    },
    {
      "id": "flstudio",
      "name": "FL Studio",
      "mac": ["com.image-line.flstudio"],
      "windows": ["fl64.exe", "fl64 (scaled).exe"],
      "commands": [
        {"key": "1", "label": "Go to start",        "send": "home", "note": "In the Playlist"},
        {"key": "3", "label": "Add marker",         "send": "t", "mods": ["option"]},
        {"key": "4", "label": "Playlist",           "send": "f5"},
        {"key": "5", "label": "Metronome on/off",   "send": "m", "mods": ["command"], "note": "Not from the Piano roll"},
        {"key": "q", "label": "Undo",               "send": "z", "mods": ["command", "option"], "note": "Steps back through the history"},
        {"key": "e", "label": "Record mode on/off", "send": "r", "note": "Then Space plays and records"},
        {"key": "t", "label": "Channel Rack",       "send": "f6"},
        {"key": "a", "label": "Previous channel",   "send": "up_arrow", "repeat": true},
        {"key": "s", "label": "Solo track",         "send": "s", "note": "The selected Mixer track, with the Mixer in front"},
        {"key": "d", "label": "Next channel",       "send": "down_arrow", "repeat": true},
        {"key": "f", "label": "Zoom to fit",        "send": "4", "mods": ["shift"]},
        {"key": "g", "label": "Save",               "send": "s", "mods": ["command"]},
        {"key": "z", "label": "Zoom out",           "send": "page_down", "repeat": true},
        {"key": "x", "label": "Zoom in",            "send": "page_up", "repeat": true},
        {"key": "c", "label": "Mixer",              "send": "f9"},
        {"key": "v", "label": "Piano roll",         "send": "f7"},
        {"key": "b", "label": "Browser",            "send": "f8", "mods": ["option"]}
      ]
    }
  ]
}
